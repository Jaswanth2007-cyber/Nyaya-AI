# Get a free key at https://console.groq.com/keys (no credit card required)
GROQ_API_KEY=

# Free, supports JSON mode. Swap for another Groq-hosted free model if you prefer.
GROQ_MODEL=openai/gpt-oss-120b

# Must match the Vite dev proxy target in frontend/vite.config.ts (server.proxy['/api'].target)
PORT=8000

# Secret used to sign login session tokens. Any long random string works.
# If left blank, a random one is generated per server start (sessions won't
# survive a restart) — fine for local dev, set a real value for anything persistent.
JWT_SECRET=

# Comma-separated list of allowed origins for CORS in production.
# Leave empty in local dev — the Vite proxy makes CORS moot.
CORS_ORIGIN=

# Pino log level: trace | debug | info | warn | error | silent. Defaults to info.
LOG_LEVEL=
